# ==============================================================================
# ARMANO MANUFACTURING — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Security Rule: NEVER commit real production secrets to Git.
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database (B2B RFQ Persistence)
# ------------------------------------------------------------------------------
# Project URL from Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"

# Optional client-facing URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# SERVER-ONLY: Supabase Service Role Key (Bypasses RLS for server-side persistence)
# CRITICAL: NEVER prefix with NEXT_PUBLIC_ or expose in browser code.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ------------------------------------------------------------------------------
# 2. Resend Transactional Email Integration
# ------------------------------------------------------------------------------
# Resend API Key from resend.com -> API Keys
RESEND_API_KEY="re_your_resend_api_key_here"

# Intended RFQ Recipient Gmail Account (Created by Client)
# Configured exclusively through this server environment variable (never hardcoded in source)
RFQ_RECIPIENT_EMAIL="armanoindustries@gmail.com"

# Outbound Sender Address (Separate variable; do not invent a sender address)
# Must belong to an authorised, verified domain in Resend once configured
RFQ_FROM_EMAIL=""

# Production Email Gate (Security Switch)
# Set to 'true' ONLY after the outbound sender domain has been formally verified in Resend.
# While 'false', outbound email remains disabled while database persistence operates independently.
ENABLE_PRODUCTION_EMAIL="false"

# ------------------------------------------------------------------------------
# 3. Cloudflare Turnstile Anti-Bot Security
# ------------------------------------------------------------------------------
# Public Site Key rendered in browser widget (Cloudflare Turnstile Dashboard)
# Cloudflare Test Site Key (Always Passes): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# SERVER-ONLY Secret Key used for /turnstile/v0/siteverify
# Cloudflare Test Secret Key (Always Passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ------------------------------------------------------------------------------
# 4. Privacy & Rate Limiting Salt
# ------------------------------------------------------------------------------
# Secret salt used for HMAC-SHA-256 client identifier hashing (DPDP Act 2023 compliance)
RATE_LIMIT_SALT="your-random-32-char-salt-here"
